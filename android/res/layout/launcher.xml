<?xml version="1.0" encoding="utf-8"?>
<!-- LauncherActivity: the game folder and the command line -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fitsSystemWindows="true">
<LinearLayout
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="24dp">
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="16dp"
		android:text="@string/title"
		android:textAppearance=
			"@android:style/TextAppearance.Material.Headline" />
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:labelFor="@+id/basedir"
		android:text="Game folder, with id1 and the mods in it" />
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<EditText android:id="@id/basedir"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:inputType="textUri"
			android:imeOptions="actionNext|flagNoExtractUi"
			android:nextFocusDown="@+id/args" />
		<Button android:id="@+id/browse"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minWidth="120dp"
			android:text="Browse" />
	</LinearLayout>
	<!-- what the game will find there, see LauncherActivity.check -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical">
		<TextView android:id="@+id/status"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:paddingStart="4dp" />
		<Button android:id="@+id/grant"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minWidth="120dp"
			android:text="Grant"
			android:visibility="gone" />
	</LinearLayout>
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:labelFor="@id/args"
		android:text="Launch options" />
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<EditText android:id="@id/args"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:inputType="text|textNoSuggestions"
			android:imeOptions="actionGo|flagNoExtractUi"
			android:hint="e.g. -game ad +map start">
			<requestFocus />
		</EditText>
		<Button android:id="@+id/play"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minWidth="120dp"
			android:text="Play" />
	</LinearLayout>
</LinearLayout>
</ScrollView>
